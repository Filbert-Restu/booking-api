                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"Dokumen tidak lengkap\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/documents/1/reject",
              "host": ["{{base_url}}"],
              "path": ["documents", "1", "reject"]
            }
          }
        },
        {
          "name": "Revise Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"notes\": \"Perlu ditambahkan data peserta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/documents/1/revise",
              "host": ["{{base_url}}"],
              "path": ["documents", "1", "revise"]
            }
          }
        }
      ]
    }
  ]
}
