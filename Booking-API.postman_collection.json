{
  "info": {
    "name": "Booking API",
    "description": "API Collection untuk Sistem Peminjaman Tempat dengan Workflow (Session-based Auth)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "xsrf_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get CSRF Cookie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
                  "if (xsrfCookie) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(xsrfCookie));",
                  "    console.log('XSRF Token saved:', decodeURIComponent(xsrfCookie));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/sanctum/csrf-cookie",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["sanctum", "csrf-cookie"]
            },
            "description": "Panggil endpoint ini PERTAMA KALI sebelum login/register untuk mendapatkan CSRF token"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"role_id\": 1,\n    \"unit_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@ft.ac.id\",\n    \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Workflows",
      "item": [
        {
          "name": "Get All Workflows",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/workflows",
              "host": ["{{base_url}}"],
              "path": ["workflows"]
            }
          }
        },
        {
          "name": "Get Workflow by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/workflows/1",
              "host": ["{{base_url}}"],
              "path": ["workflows", "1"]
            }
          }
        },
        {
          "name": "Create Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Approval Peminjaman Ruangan\",\n    \"description\": \"Workflow untuk proses peminjaman ruangan\",\n    \"applies_to_category\": \"HIMA\",\n    \"steps\": [\n        {\n            \"step_order\": 1,\n            \"step_name\": \"Review Ketua HIMA\",\n            \"target_role_slug\": \"ketua-hima\",\n            \"scope_type\": \"SELF\",\n            \"target_category_lookup\": null\n        },\n        {\n            \"step_order\": 2,\n            \"step_name\": \"Persetujuan Ketua Prodi\",\n            \"target_role_slug\": \"ketua-prodi\",\n            \"scope_type\": \"PARENT\",\n            \"target_category_lookup\": null\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/workflows",
              "host": ["{{base_url}}"],
              "path": ["workflows"]
            }
          }
        },
        {
          "name": "Update Workflow",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Approval Peminjaman Ruangan (Updated)\",\n    \"description\": \"Workflow updated\",\n    \"applies_to_category\": \"HIMA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/workflows/1",
              "host": ["{{base_url}}"],
              "path": ["workflows", "1"]
            }
          }
        },
        {
          "name": "Delete Workflow",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/workflows/1",
              "host": ["{{base_url}}"],
              "path": ["workflows", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Get All Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents",
              "host": ["{{base_url}}"],
              "path": ["documents"]
            }
          }
        },
        {
          "name": "Get Document by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/documents/1",
              "host": ["{{base_url}}"],
              "path": ["documents", "1"]
            }
          }
        },
        {
          "name": "Create Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Peminjaman Ruang Meeting\",\n    \"content\": \"Permohonan peminjaman ruang meeting untuk acara workshop\",\n    \"workflow_id\": 1,\n    \"metadata\": {\n        \"tanggal\": \"2026-01-25\",\n        \"waktu\": \"09:00-12:00\",\n        \"jumlah_peserta\": 30\n    }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/documents",
              "host": ["{{base_url}}"],
              "path": ["documents"]
            }
          }
        },
        {
          "name": "Update Document",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Peminjaman Ruang Meeting (Updated)\",\n    \"content\": \"Updated content\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/documents/1",
              "host": ["{{base_url}}"],
              "path": ["documents", "1"]
            }
          }
        },
        {
          "name": "Submit Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"notes\": \"Dokumen siap untuk diproses\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/documents/1/submit",
              "host": ["{{base_url}}"],
              "path": ["documents", "1", "submit"]
            }
          }
        },
        {
          "name": "Approve Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"notes\": \"Disetujui\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/documents/1/approve",
              "host": ["{{base_url}}"],
              "path": ["documents", "1", "approve"]
            }
          }
        },
        {
          "name": "Reject Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
