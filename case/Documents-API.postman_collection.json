            "body": {
              "mode": "raw",
              "raw": "{\n    \"workflow_id\": 1,\n    \"title\": \"Permohonan Peminjaman Aula untuk Seminar Nasional\",\n    \"content\": {\n        \"event_name\": \"Seminar Nasional Teknologi Informasi 2026\",\n        \"event_date\": \"2026-03-20\",\n        \"organizer\": \"HIMA Teknik Informatika\",\n        \"contact_person\": \"Ahmad Rizki\",\n        \"phone\": \"081234567890\",\n        \"participants\": 200,\n        \"purpose\": \"Seminar nasional dengan pembicara dari berbagai universitas\"\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/documents",
              "host": ["{{base_url}}"],
              "path": ["documents"]
            }
          }
        },
