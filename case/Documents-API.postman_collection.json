{
  "info": {
    "name": "Documents API - Complete Test Cases",
    "description": "API Collection untuk Document Management dengan Workflow Integration (Bearer Token Auth)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "document_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Setup",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set('auth_token', response.token);",
                  "    console.log('Bearer token saved:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@ft.ac.id\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Login as Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set('auth_token', response.token);",
                  "    console.log('Bearer token saved:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"staff@ft.ac.id\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        }
      ]
    },
    {
      "name": "Documents - List & Filter",
      "item": [
        {
          "name": "List - Get All Documents",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents",
              "host": ["{{base_url}}"],
              "path": ["documents"]
            }
          }
        },
        {
          "name": "List - My Documents Only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?my_documents=true",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [{ "key": "my_documents", "value": "true" }]
            }
          }
        },
        {
          "name": "List - Documents I Need to Action",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?need_action=true",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [{ "key": "need_action", "value": "true" }]
            }
          }
        },
        {
          "name": "List - Filter by Status DRAFT",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?status=DRAFT",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [{ "key": "status", "value": "DRAFT" }]
            }
          }
        },
        {
          "name": "List - Filter by Status IN_REVIEW",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?status=IN_REVIEW",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [{ "key": "status", "value": "IN_REVIEW" }]
            }
          }
        },
        {
          "name": "List - Filter by Status APPROVED",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?status=APPROVED",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [{ "key": "status", "value": "APPROVED" }]
            }
          }
        },
        {
          "name": "List - Filter by Status REJECTED",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?status=REJECTED",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [{ "key": "status", "value": "REJECTED" }]
            }
          }
        },
        {
          "name": "List - Filter by Workflow",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?workflow_id=1",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [{ "key": "workflow_id", "value": "1" }]
            }
          }
        },
        {
          "name": "List - Search by Title",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?search=peminjaman",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [{ "key": "search", "value": "peminjaman" }]
            }
          }
        },
        {
          "name": "List - Multiple Filters Combined",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/documents?status=IN_REVIEW&workflow_id=1&my_documents=false&need_action=true",
              "host": ["{{base_url}}"],
              "path": ["documents"],
              "query": [
                { "key": "status", "value": "IN_REVIEW" },
                { "key": "workflow_id", "value": "1" },
                { "key": "my_documents", "value": "false" },
                { "key": "need_action", "value": "true" }
              ]
            }
          }
        }
      ]
    },
