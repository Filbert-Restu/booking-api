    {
      "name": "User Statistics & Reports",
      "item": [
        {
          "name": "Get User Statistics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?stats=true",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{ "key": "stats", "value": "true" }]
            },
            "description": "Get statistics like total users, by role, by status, etc."
          }
        },
        {
          "name": "Get Users by Department",
          "request": {
            "method": "GET",
            "header": [
