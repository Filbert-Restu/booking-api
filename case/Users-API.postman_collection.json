{
  "info": {
    "name": "Users API - Complete Test Cases",
    "description": "API Collection untuk User Management System (Bearer Token Auth)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth Setup",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set('auth_token', response.token);",
                  "    console.log('Bearer token saved:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@ft.ac.id\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Get Current User Info",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        }
      ]
    },
    {
      "name": "Users - List & Filter",
      "item": [
        {
          "name": "List - Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "List - Filter by Role Admin",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?role_id=1",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{ "key": "role_id", "value": "1" }]
            }
          }
        },
        {
          "name": "List - Filter by Role Staff",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?role_id=2",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{ "key": "role_id", "value": "2" }]
            }
          }
        },
        {
          "name": "List - Filter by Unit",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?unit_id=1",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{ "key": "unit_id", "value": "1" }]
            }
          }
        },
        {
          "name": "List - Filter by Status ACTIVE",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?status=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{ "key": "status", "value": "ACTIVE" }]
            }
          }
        },
        {
          "name": "List - Search by Name or Email",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?search=admin",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [{ "key": "search", "value": "admin" }]
            }
          }
        },
        {
          "name": "List - Multiple Filters Combined",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?role_id=2&unit_id=1&status=ACTIVE",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "role_id", "value": "2" },
                { "key": "unit_id", "value": "1" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        }
      ]
    },
    {
