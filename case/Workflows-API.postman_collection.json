    {
      "name": "Workflow Steps Management",
      "item": [
        {
          "name": "Add Step - Ketua Jurusan Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.steps && response.data.steps.length > 0) {",
                  "    const lastStep = response.data.steps[response.data.steps.length - 1];",
                  "    pm.collectionVariables.set('step_id', lastStep.id);",
                  "    console.log('Step ID saved:', lastStep.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"step_order\": 1,\n    \"role_id\": 2,\n    \"step_name\": \"Review Ketua Jurusan\",\n    \"description\": \"Persetujuan awal dari Ketua Jurusan\",\n    \"is_required\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/workflows/{{workflow_id}}/steps",
              "host": ["{{base_url}}"],
              "path": ["workflows", "{{workflow_id}}", "steps"]
            }
          }
        },
        {
          "name": "Add Step - Wakil Dekan Approval",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"step_order\": 2,\n    \"role_id\": 3,\n    \"step_name\": \"Persetujuan Wakil Dekan\",\n    \"description\": \"Persetujuan dari Wakil Dekan Bidang Kemahasiswaan\",\n    \"is_required\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/workflows/{{workflow_id}}/steps",
              "host": ["{{base_url}}"],
              "path": ["workflows", "{{workflow_id}}", "steps"]
            }
          }
        },
        {
          "name": "Add Step - Final Dekan Approval",
